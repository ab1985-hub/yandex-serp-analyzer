# Yandex Cloud — Search API key
# Получить: https://console.yandex.cloud → IAM → Сервисные аккаунты → API-ключ
YANDEX_API_KEY=your_yandex_api_key_here

# Yandex Cloud — Folder ID (каталог)
# Получить: https://console.yandex.cloud → выпадающий список слева вверху
YANDEX_FOLDER_ID=your_yandex_folder_id_here

# SERP-прокси URL (для загрузки HTML страниц при углублённом анализе)
# Оставить пустым если не используется
SERP_PROXY_URL=
